# Transport
MCP_TRANSPORT=stdio          # stdio | http
MCP_HTTP_PORT=3000
MCP_HTTP_HOST=0.0.0.0
MCP_API_KEY=                 # optional bearer token for HTTP transport

# MarkLogic connection
ML_HOST=localhost
ML_PORT=8000
ML_MANAGEMENT_PORT=8002
ML_USERNAME=admin
ML_PASSWORD=admin
ML_DATABASE=Documents
ML_SSL=false
ML_SSL_REJECT_UNAUTHORIZED=true
ML_AUTH_TYPE=digest          # digest | basic
ML_TIMEOUT_MS=30000

# Safety (default: read-only, no eval)
ML_READONLY=true
ML_ALLOW_EVAL=false

# AWS QuickSight (optional)
AWS_REGION=us-east-1
AWS_QUICKSIGHT_ACCOUNT_ID=

# Logging
LOG_LEVEL=info               # debug | info | warn | error
LOG_FORMAT=json              # json | pretty
