# Copy to .env for `npm start`, `npm run dev`, and Docker.
#
# NOTE: this file is only read when the server process starts in this directory.
# In stdio mode your MCP client launches the server from its own directory, so put the
# settings in the client's "env" block instead (see README "Quick Start").

# Transport
MCP_TRANSPORT=stdio          # stdio (default — client launches the server) | http (shared/remote deployments)
MCP_HTTP_PORT=3000
MCP_HTTP_HOST=0.0.0.0
MCP_API_KEY=                 # optional bearer token for HTTP transport
MCP_CORS_ORIGIN=             # optional: restrict CORS to a single origin, e.g. https://app.example.com (default: allow all)

# MarkLogic connection
ML_HOST=localhost
ML_PORT=8000
ML_MANAGEMENT_PORT=8002
ML_USERNAME=admin
ML_PASSWORD=admin
ML_DATABASE=Documents
ML_SSL=false
ML_SSL_REJECT_UNAUTHORIZED=true
ML_AUTH_TYPE=digest          # digest | basic | oauth
# ML_OAUTH_TOKEN=            # required in stdio mode when ML_AUTH_TYPE=oauth (static Bearer token)
ML_TIMEOUT_MS=30000

# Flux sidecar (required for flux_import / flux_export tools)
FLUX_RUNNER_URL=http://localhost:8080  # internal Docker default; expose port 8080 if running flux-runner in Docker

# Safety (default: read-only, no eval)
ML_READONLY=true
ML_ALLOW_EVAL=false

# AWS QuickSight (optional)
AWS_REGION=us-east-1
AWS_QUICKSIGHT_ACCOUNT_ID=

# Semaphore (Progress Data Platform — optional)
# Shared host for both the Classification Server (SCS) and Studio (KMM).
SEMAPHORE_HOST=              # e.g. semaphore.example.com
SEMAPHORE_SCS_PORT=5058      # Classification Server port (default: 5058)
SEMAPHORE_KMM_PORT=5080      # Studio / KMM port (default: 5080)
SEMAPHORE_USERNAME=          # For Semaphore Studio (KMM) API authentication
SEMAPHORE_PASSWORD=
SEMAPHORE_SSL=false
SEMAPHORE_TIMEOUT_MS=30000
# SEMAPHORE_URL=             # Explicit SCS URL override (backward compat, e.g. http://semaphore.example.com:5058)

# DHF client JAR (optional — enables dhf_flow_run_jar for large-scale flows without eval)
# The Docker image bundles the JAR and sets ML_DHF_CLIENT_JAR=/app/marklogic-data-hub-client.jar automatically.
# Override DHF_VERSION build arg (default 5.8.1) to bundle a different version.
ML_DHF_CLIENT_JAR=           # absolute path to marklogic-data-hub-<ver>-client.jar
ML_DHF_PORT=                 # DHF staging app server port (defaults to ML_PORT; often 8010 in standard DHF deployments)
ML_DHF_JOBS_PORT=            # DHF jobs app server port (defaults to ML_DHF_PORT+2; e.g. 8012 or 8022 for on-premise)

# Logging
LOG_LEVEL=info               # debug | info | warn | error
LOG_FORMAT=json              # json | pretty
