# Transport
MCP_TRANSPORT=stdio          # stdio | http
MCP_HTTP_PORT=3000
MCP_HTTP_HOST=0.0.0.0
MCP_API_KEY=                 # optional bearer token for HTTP transport

# MarkLogic connection
ML_HOST=localhost
ML_PORT=8000
ML_MANAGEMENT_PORT=8002
ML_USERNAME=admin
ML_PASSWORD=admin
ML_DATABASE=Documents
ML_SSL=false
ML_SSL_REJECT_UNAUTHORIZED=true
ML_AUTH_TYPE=digest          # digest | basic
ML_TIMEOUT_MS=30000

# Flux sidecar (required for flux_import / flux_export tools)
FLUX_RUNNER_URL=http://localhost:8080  # internal Docker default; expose port 8080 if running flux-runner in Docker

# Safety (default: read-only, no eval)
ML_READONLY=true
ML_ALLOW_EVAL=false

# AWS QuickSight (optional)
AWS_REGION=us-east-1
AWS_QUICKSIGHT_ACCOUNT_ID=

# Semaphore (Progress Data Platform — optional)
# Shared host for both the Classification Server (SCS) and Studio (KMM).
SEMAPHORE_HOST=              # e.g. semaphore.example.com
SEMAPHORE_SCS_PORT=5058      # Classification Server port (default: 5058)
SEMAPHORE_KMM_PORT=5080      # Studio / KMM port (default: 5080)
SEMAPHORE_USERNAME=          # For Semaphore Studio (KMM) API authentication
SEMAPHORE_PASSWORD=
SEMAPHORE_SSL=false
SEMAPHORE_TIMEOUT_MS=30000
# SEMAPHORE_URL=             # Explicit SCS URL override (backward compat, e.g. http://semaphore.example.com:5058)

# Logging
LOG_LEVEL=info               # debug | info | warn | error
LOG_FORMAT=json              # json | pretty
